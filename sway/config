# Sway config mirroring aerospace/aerospace.toml
# super = window management, super+alt = system actions (sent by keyd's Cmd layer)

set $mod Mod4
set $sys Mod4+Mod1
set $term ghostty
set $menu fuzzel
set $scripts ~/.config/sway/scripts
set $lock gtklock -d -s ~/.config/gtklock/style.css

# Outputs (swaymsg -t get_outputs): letters on $mon1, numbers on $mon2
set $mon1 DP-2
set $mon2 HDMI-A-1

# ---Appearance (Gruvbox Dark Hard)---

set $bg     #1d2021
set $fg     #ebdbb2
set $gray   #504945
set $accent #a89984
set $red    #cc241d

font pango:Iosevka Term 12
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
smart_borders on

# class                 border   bg       text     indicator child_border
client.focused          $accent  $bg      $fg      $accent   $accent
client.focused_inactive $gray    $bg      $fg      $gray     $gray
client.unfocused        $gray    $bg      $gray    $gray     $gray
client.urgent           $red     $bg      $fg      $red      $red

output * bg $bg solid_color
output * scale 1.5
output $mon1 mode 3840x2160@160Hz
# Match GTK's cursor
seat seat0 xcursor_theme Yaru 24

# ---Input---

input type:keyboard {
    repeat_delay 350
    repeat_rate 30
}

input type:pointer {
    natural_scroll enabled
    pointer_accel -1
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

floating_modifier $mod normal
focus_follows_mouse no

# ---Focus / move---

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Return fullscreen toggle

# ---Layout---

# tiles
bindsym $mod+slash layout toggle split
# accordion
bindsym $mod+comma layout toggle tabbed stacking

# resize smart
bindsym $mod+minus exec $scripts/smart-resize.sh shrink
bindsym $mod+equal exec $scripts/smart-resize.sh grow

# ---Workspaces---

workspace 1 output $mon2
workspace 2 output $mon2
workspace 3 output $mon2
workspace 4 output $mon2
workspace 5 output $mon2
workspace 6 output $mon2
workspace 7 output $mon2
workspace 8 output $mon2
workspace 9 output $mon2
workspace A output $mon1
workspace B output $mon1
workspace C output $mon1
workspace D output $mon1
workspace E output $mon1
workspace F output $mon1
workspace G output $mon1
workspace I output $mon1
workspace M output $mon1
workspace N output $mon1
workspace O output $mon1
workspace P output $mon1
workspace Q output $mon1
workspace R output $mon1
workspace S output $mon1
workspace T output $mon1
workspace U output $mon1
workspace V output $mon1
workspace W output $mon1
workspace X output $mon1
workspace Y output $mon1
workspace Z output $mon1

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+a workspace A
bindsym $mod+b workspace B
bindsym $mod+c workspace C
bindsym $mod+d workspace D
bindsym $mod+e workspace E
bindsym $mod+f workspace F
bindsym $mod+g workspace G
bindsym $mod+i workspace I
bindsym $mod+m workspace M
bindsym $mod+n workspace N
bindsym $mod+o workspace O
bindsym $mod+p workspace P
bindsym $mod+q workspace Q
bindsym $mod+r workspace R
bindsym $mod+s workspace S
bindsym $mod+t workspace T
bindsym $mod+u workspace U
bindsym $mod+v workspace V
bindsym $mod+w workspace W
bindsym $mod+x workspace X
bindsym $mod+y workspace Y
bindsym $mod+z workspace Z

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+a move container to workspace A
bindsym $mod+Shift+b move container to workspace B
bindsym $mod+Shift+c move container to workspace C
bindsym $mod+Shift+d move container to workspace D
bindsym $mod+Shift+e move container to workspace E
bindsym $mod+Shift+f move container to workspace F
bindsym $mod+Shift+g move container to workspace G
bindsym $mod+Shift+i move container to workspace I
bindsym $mod+Shift+m move container to workspace M
bindsym $mod+Shift+n move container to workspace N
bindsym $mod+Shift+o move container to workspace O
bindsym $mod+Shift+p move container to workspace P
bindsym $mod+Shift+q move container to workspace Q
bindsym $mod+Shift+r move container to workspace R
bindsym $mod+Shift+s move container to workspace S
bindsym $mod+Shift+t move container to workspace T
bindsym $mod+Shift+u move container to workspace U
bindsym $mod+Shift+v move container to workspace V
bindsym $mod+Shift+w move container to workspace W
bindsym $mod+Shift+x move container to workspace X
bindsym $mod+Shift+y move container to workspace Y
bindsym $mod+Shift+z move container to workspace Z

bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Shift+Tab move workspace to output right

# ---Service mode---

mode "service" {
    bindsym Escape reload; mode "default"
    bindsym r layout splith; mode "default"
    bindsym f floating toggle; mode "default"
    bindsym BackSpace exec $scripts/close-others.sh; mode "default"
}
bindsym $mod+Shift+semicolon mode "service"

# ---Quick terminal---

# Started on first use (and again if closed)
for_window [app_id="dev\.ghostty\.quick"] floating enable, resize set 50 ppt 60 ppt, move position center, move scratchpad, scratchpad show
bindsym $mod+grave exec swaymsg '[app_id="^dev.ghostty.quick$"] scratchpad show' || $term --class=dev.ghostty.quick

# ---Discord (scratchpad)---

for_window [app_id="(?i)discord"] floating enable, resize set 70 ppt 75 ppt, move position center, move scratchpad
for_window [class="(?i)discord"] floating enable, resize set 70 ppt 75 ppt, move position center, move scratchpad
bindsym $mod+apostrophe [app_id="(?i)discord"] scratchpad show; [class="(?i)discord"] scratchpad show

# ---System---

bindsym $sys+Return exec $term
bindsym $sys+space exec $menu
bindsym $sys+Tab exec $scripts/window-switcher.sh
bindsym $sys+q kill
bindsym $sys+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Exit' 'swaymsg exit'
bindsym $sys+Escape exec $lock
bindsym $sys+Shift+4 exec grim -g "$(slurp)" - | wl-copy
bindsym $sys+Shift+3 exec grim - | wl-copy

# ---Media keys---

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# ---Floating apps---

for_window [app_id="(?i)pavucontrol|mpv|nm-connection-editor|blueman-manager|org\.gnome\.Settings"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

# No idle lock while fullscreen
for_window [all] inhibit_idle fullscreen

# ---Bar---

bar {
    swaybar_command waybar
}

# ---Autostart---

# Skip GDM's 10s login timeout
exec gdbus call --system --dest org.gnome.DisplayManager --object-path /org/gnome/DisplayManager/Manager --method org.gnome.DisplayManager.Manager.RegisterSession
exec mako
# Polkit agent
exec lxpolkit
exec swayidle -w \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lock' \
    lock '$lock'

include /etc/sway/config.d/*
