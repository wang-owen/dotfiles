# Installed (copied, root-owned) by away/install.sh. Toggle with `away on|off`.
[Unit]
Description=Away mode: keep the machine awake for remote work

[Service]
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=away --why="Away mode is on" /usr/bin/sleep infinity

[Install]
WantedBy=multi-user.target
